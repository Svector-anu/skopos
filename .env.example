# Copy to .env.local and fill in. Without these, local dev differs from prod:
# a missing NEXT_PUBLIC_PRIVY_APP_ID makes PrivyProvider throw
# "invalid Privy app ID" and crashes the entire /app route.

# Privy — PUBLIC values (shipped in the client bundle; not secrets).
# Required for wallet/auth. The /app route will not render without the app id.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Solana RPC — optional (defaults to mainnet-beta public RPC).
NEXT_PUBLIC_SOLANA_RPC=

# Server-side secrets — required for chat/LLM, quotes, portfolio.
GROQ_API_KEY=
DELORA_API_KEY=
DELORA_INTEGRATOR=ANU
ALCHEMY_API_KEY=

# Optional — enables in-chat token launch via Bankr Partner Deploy API.
BANKR_PARTNER_KEY=

# Optional — ✦ Smart tier (Bankr LLM Gateway). Absent → Smart silently falls back
# to Groq (Fast). Metering uses Upstash; absent → Smart is uncapped (fails open).
BANKR_LLM_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SMART_FREE_DAILY_CAP=20
SMART_ANON_TEASER_CAP=2

# Optional — Smart subscription (Phase 3). Purchases run through the Bankr x402
# Cloud endpoint, but the browser cannot call it directly (Bankr gates the CORS
# preflight), so app/api/subscribe proxies the x402 exchange same-origin. The
# wallet still signs client-side; the Bankr handler grants the sub by writing to
# the same Upstash above, which isEntitled() reads. Price lives in bankr.x402.json.
#
# Public: where the paywall's Subscribe button posts. Point at the same-origin
# proxy. Absent → the button stays inert.
NEXT_PUBLIC_SUBSCRIBE_URL=/api/subscribe
# Server-side: the real Bankr x402 endpoint the proxy relays to
# (x402.bankr.bot/<wallet>/skopos-subscribe). Absent → the proxy returns 503.
SUBSCRIBE_UPSTREAM_URL=
